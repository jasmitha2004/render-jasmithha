# ContextBridge AI — placeholders only. Copy to .env and edit. Never commit .env.

# --- Backend (Django) ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
# Comma-separated; required when DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
# Leave unset for local SQLite; set for PostgreSQL (Render injects this automatically)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# MEDIA_ROOT=/var/data/media
# MAX_UPLOAD_MB=10
# LOG_LEVEL=INFO

# --- AI (optional; rule-based extraction is used when empty) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Demo data ---
# DEMO_PASSWORD=choose-a-demo-password

# --- Frontend (Streamlit) ---
CONTEXTBRIDGE_API=http://127.0.0.1:8000/api
# CONTEXTBRIDGE_API_TIMEOUT=60
# CONTEXTBRIDGE_DEMO_MODE=false
